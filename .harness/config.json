{
  "setup": "npm ci",
  "verify": "npm run test",
  "externalWorker": {
    "enabled": false,
    "command": null
  },
  "docsGate": {
    "enabled": true,
    "include": [
      "**/*.mjs",
      "**/*.js",
      "**/*.cjs",
      "**/*.ts",
      "**/*.tsx",
      "**/*.jsx",
      "**/*.py",
      "**/*.go",
      "**/*.cs",
      "**/*.java",
      "**/*.rb",
      "**/*.rs",
      "**/*.php"
    ],
    "exclude": [
      "docs/**",
      "test/**",
      "tests/**",
      "**/*.md",
      "issues.json"
    ]
  }
}
