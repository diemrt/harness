{
  "schema_version": 5,
  "setup": "npm ci",
  "verify": "npm run test",
  "externalWorker": {
    "enabled": false,
    "command": null
  },
  "docsGate": {
    "enabled": true,
    "include": [
      "**/*.mjs",
      "**/*.js",
      "**/*.cjs",
      "**/*.ts",
      "**/*.tsx",
      "**/*.jsx",
      "**/*.py",
      "**/*.go",
      "**/*.cs",
      "**/*.java",
      "**/*.rb",
      "**/*.rs",
      "**/*.php"
    ],
    "exclude": [
      "docs/**",
      "test/**",
      "tests/**",
      "**/*.md",
      ".harness/**"
    ]
  },
  "execution": {
    "mode": "auto"
  }
}
